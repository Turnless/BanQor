# Copy to .env (never commit .env). Testnet only.
# Addresses of Mezo and BanQor contracts live in deployments/<CHAIN_ID>.json, not here.

# ---- Network ----
CHAIN_ID=31611
# RPC for forge, scripts and the API. Empty = the "rpc" in deployments/<CHAIN_ID>.json.
MEZO_RPC=https://rpc.test.mezo.org

# ---- Keys (testnet) ----
# Vault owner: deploys the factory, opens the trove, sets policies. Needs testnet BTC (faucet.test.mezo.org).
OWNER_KEY=
# Agent EOA: calls draw() and signs x402 payments. setup funds it with a little BTC for gas.
AGENT_KEY=
# Address that receives the demo API's x402 payments.
PAY_TO=
# Optional key for PAY_TO (only to move the demo earnings out; no script needs it).
PAY_TO_KEY=

# ---- Factory deploy (forge script, all optional) ----
# DEPLOY_ICR_FLOOR_BPS=20000          # default floor for new vaults (200%)
# DEPLOY_REBALANCE_BUFFER_BPS=1000    # rebalance allowed below floor + 10%
# DEPLOY_BORROW_BUFFER_WEI=5000000000000000000   # 5 MUSD extra per borrow
# DEPLOY_HINT_TRIALS=15

# ---- Demo API ----
API_PORT=4021
API_PRICE_PATH_PRICE=$0.01
API_PRICE_PATH_FUNDING=$0.02
API_PRICE_PATH_SENTIMENT=$0.05
# Empty = the "facilitator" in deployments/<CHAIN_ID>.json
FACILITATOR_URL=
# Public data sources (defaults shown); cached, with a bundled fallback snapshot
DATA_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_24hr_change=true
DATA_FUNDING_URL=https://api.coingecko.com/api/v3/derivatives?include_tickers=unexpired
DATA_SENTIMENT_URL=https://api.alternative.me/fng/?limit=1
DATA_CACHE_SECONDS=60
DATA_FUNDING_CACHE_SECONDS=300

# ---- Owner setup script ----
SETUP_COLLATERAL_BTC=0.07
SETUP_DEBT_MUSD=1800
SETUP_AGENT_DAILY_CAP=20
SETUP_AGENT_MAX_FLOAT=2
SETUP_AGENT_MAX_DRAW=1
# 0 = never expires
SETUP_AGENT_EXPIRY_DAYS=30
SETUP_AGENT_GAS_BTC=0.0005

# ---- Demo agent ----
API_BASE_URL=http://localhost:4021
AGENT_CALLS=100
AGENT_ENDPOINTS=/price,/funding,/sentiment
AGENT_MIN_FLOAT=0.20
AGENT_TOP_UP=1.00
AGENT_MAX_PRICE_PER_CALL=0.10
# Empty = deployments/<CHAIN_ID>.json banqor.demoVault (written by setup)
VAULT=

# ---- Dashboard (Vite, build-time) ----
# VITE_CHAIN_ID=31611
# VITE_MEZO_RPC=
# VITE_POLL_MS=10000
# VITE_LOGS_MAX_RANGE=10000
# VITE_ACTIVITY_LOOKBACK_BLOCKS=50000
# VITE_ACTIVITY_LIMIT=50
# VITE_HINT_TRIALS=15
# VITE_LIQUIDATION_WARN_BPS=1000   # warn within 10% of the 110% liquidation line
